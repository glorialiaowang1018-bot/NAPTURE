# Frontend dependencies and build output
**/node_modules/
**/dist/
**/.vite/
**/*.tsbuildinfo

# Python environments and caches
**/.venv/
**/__pycache__/
**/*.py[cod]

# Runtime data and local configuration
**/nap_app_state.json
**/.env
**/.env.*
!**/.env.example
**/logs/
**/*.log
**/*.tmp

# Large local models and generated media
**/*.pt
**/*.onnx
*.mp4
*.zip

# Editor and tool state
.vscode/
**/.DS_Store
**/*.code-workspace
**/.figma/
**/.playwright-mcp/
**/.git/
