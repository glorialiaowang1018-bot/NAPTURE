PORT=5000

# 云端部署时建议开启。开启后后端持续接收数据，不依赖教师端网页心跳。
CLOUD_RUNTIME_ALWAYS_ON=1

# 本地演示时，小晴绑定到本机真实干预页面/白噪声。
# 云端部署时通常不要打开本机浏览器干预，可以保留默认或按设备编号调整。
LOCAL_INTERVENTION_CHILD_ID=demo-015

# 可选：如果要生成 AI 睡前故事，填 DashScope Key。没有也会使用内置故事。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-turbo

# LLM 重新评估传感器阈值的最短间隔（秒）。
LLM_DECISION_INTERVAL_SECONDS=120
